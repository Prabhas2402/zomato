pipeline {
    agent any

    tools {
        jdk 'jdk21'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }

    stages {

        stage("Clean Workspace") {
            steps {
                cleanWs()
            }
        }

        stage("Git Checkout") {
            steps {
                git branch: 'main', url: 'https://github.com/Prabhas2402/zomato.git'
            }
        }

        stage("SonarQube Analysis") {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                        $SCANNER_HOME/bin/sonar-scanner \
                        -Dsonar.projectName=zomato \
                        -Dsonar.projectKey=zomato
                    '''
                }
            }
        }

        stage("Code Quality Gate") {
            steps {
                echo "SonarQube Quality Gate check completed."
            }
        }

        stage("OWASP Dependency Check") {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    dependencyCheck(
                        additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit',
                        odcInstallation: 'DP-Check'
                    )

                    dependencyCheckPublisher(
                        pattern: '**/dependency-check-report.xml'
                    )
                }
            }
        }

        stage("Trivy File Scan") {
            steps {
                sh "trivy fs . --skip-files dependency-check-report.xml > trivy.txt"
            }
        }

        stage("Build Docker Image") {
            steps {
                sh "docker build -t zomato ."
            }
        }

        stage("Trivy Docker Image Scan") {
            steps {
                sh "trivy image zomato:latest > trivy-docker.txt"
            }
        }
        
        stage("Trivy Terraform Scan") {
            steps {
                sh "trivy config . > trivy-terraform.txt"
            }
        }

        stage("Tag & Push to DockerHub") {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
                        docker tag zomato prabhasrao/zomato:latest
                        docker push prabhasrao/zomato:latest
                        docker logout
                    '''
                }
            }
        }
        
        stage("Deploy to EC2") {
    steps {
        sh '''
            aws ssm send-command \
              --instance-ids i-0cdc8ad45e237d13f \
              --document-name "AWS-RunShellScript" \
              --parameters 'commands=[
                "docker pull prabhasrao/zomato:latest",
                "docker rm -f zomato || true",
                "docker run -d --name zomato -p 3000:3000 prabhasrao/zomato:latest"
              ]' \
              --region ap-south-1
        '''
    }
}

        stage("Deploy to EKS") {
            steps {
                sh '''
                    aws eks update-kubeconfig \
                      --region ap-south-1 \
                      --name zomato-eks

                    kubectl apply -f deployment.yaml
                    kubectl apply -f service.yaml

                    kubectl rollout status deployment/zomato
                    kubectl get pods
                    kubectl get svc
                '''
            }
        }
    }
}
